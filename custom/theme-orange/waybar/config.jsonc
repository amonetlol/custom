{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "mod": "dock",
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin-top": 6,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "spacing": 0,
  "height": 26,

  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "idle_inhibitor"
  ],

  "modules-center": [
    "clock",
    "custom/weather"
  ],

  "modules-right": [
    "memory",
    "cpu",
    "network",
    // "bluetooth",
    // "backlight",
    "pulseaudio",
    "tray",
    "custom/power"
  ],

  "custom/arch": {
    "format": "󰣇",
    "tooltip-format": "Menu",
    "on-click": "~/.config/custom/theme-orange/rofi/hub.sh --menu"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 1
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Não suspender: ligado",
    "tooltip-format-deactivated": "Não suspender: desligado",
    "format-icons": {
      "activated": "󱎴",
      "deactivated": "󰷛"
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d de %B de %Y — %H:%M}",
    "locale": "pt_BR.UTF-8",
    "interval": 30
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 300,
    "exec": "wttrbar --nerd --lang pt --location Ubatuba+SP",
    "return-type": "json",
    "on-click": "xdg-open https://wttr.in/Ubatuba+SP"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}GB",
    "tooltip-format": "Memória: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)",
    "on-click": "foot -e btop",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    "tooltip-format": "CPU: {usage}%",
    "on-click": "foot -e btop",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰌗",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Desconectado",
    "interval": 3,
    "on-click": "~/.config/custom/theme-orange/rofi/hub.sh --applet"
  },

  // "bluetooth": {
  //   "format": "󰂯",
  //   "format-off": "󰂲",
  //   "format-disabled": "󰂲",
  //   "format-connected": "󰂯",
  //   "format-no-controller": "",
  //   "tooltip-format": "Dispositivos: {num_connections}",
  //   "on-click": "blueman-manager"
  // },

  // "backlight": {
  //   "format": "{icon} {percent}%",
  //   "format-icons": ["󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
  //   "tooltip-format": "Brilho: {percent}%",
  //   "on-click": "brightnessctl set +5%",
  //   "on-click-right": "brightnessctl set 5-%"
  // },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Volume: {volume}%"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 2
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Menu de energia",
    "on-click": "~/.config/custom/theme-orange/rofi/hub.sh --power"
  }
}
