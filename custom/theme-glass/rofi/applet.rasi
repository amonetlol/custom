@import "shared/colors.rasi"
@import "shared/fonts.rasi"
@import "shared/elements.rasi"
@import "shared/inputbar.rasi"

configuration {
    show-icons: false;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 360px;
    border-radius: 20px;
    border: 1px solid;
    border-color: @accent;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    margin: 20px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

listview {
    lines: 8;
    cycle: true;
    dynamic: false;
    scrollbar: false;
    layout: vertical;
    fixed-height: true;
    spacing: 6px;
    background-color: transparent;
}

element {
    padding: 12px 16px;
    border-radius: 14px;
}

element selected.normal {
    background-color: @accent;
    text-color: @background;
}
